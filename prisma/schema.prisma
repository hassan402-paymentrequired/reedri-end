generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// -----------------------------
// Enums
// -----------------------------

// Account class, not app mode — which of rider/driver a user is currently
// acting as lives in User.activeProfile.
enum Role {
  USER
  // TODO(admin-portal): admins move to their own admin_users table; this
  // member and every @Roles(Role.ADMIN) gate goes away with it.
  ADMIN
}

enum ActiveProfile {
  RIDER
  DRIVER
}

enum DriverApplicationStatus {
  NOT_STARTED
  PERSONAL_INFO_SUBMITTED
  LICENSE_SUBMITTED
  VEHICLE_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum RideRequestStatus {
  PENDING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TripStatus {
  MATCHED
  STARTED
  COMPLETED
  CANCELLED
}

// The first three are required to submit a DriverApplication for review
// (see REQUIRED_DOCUMENT_TYPES); the last two are accepted whenever an
// applicant has them but never block verification.
enum DriverDocumentType {
  DRIVERS_LICENSE
  VEHICLE_REGISTRATION
  VEHICLE_PHOTO
  PROOF_OF_INSURANCE
  PROFILE_PHOTO
}

// -----------------------------
// Models
// -----------------------------

model User {
  id            String        @id @default(uuid())
  name          String
  phone         String        @unique
  password      String
  role          Role          @default(USER)
  // Which mode of the app this user is currently in. Every user is
  // rider-capable from signup; DRIVER requires a verified DriverProfile.
  activeProfile ActiveProfile @default(RIDER) @map("active_profile")
  rating        Float         @default(5.0)
  createdAt     DateTime      @default(now()) @map("created_at")

  driverApplication DriverApplication?
  driverProfile   DriverProfile?
  rideRequests    RideRequest[]   @relation("RiderRideRequests")
  tripsAsRider    Trip[]          @relation("RiderTrips")
  tripsAsDriver   Trip[]          @relation("DriverTrips")
  ratingsGiven        Rating[]              @relation("RatingsFrom")
  ratingsReceived     Rating[]              @relation("RatingsTo")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One-time SMS code for the forgot-password flow. A new request revokes any
// still-unused code for the same user (see AuthService.forgotPassword), so
// at most one row per user is ever valid at a time.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Created when a user opts into becoming a driver, then filled in over three
// separate submissions. Every step field is nullable because the record is
// built incrementally — `status` is the authority on what has actually been
// submitted, not the presence of any given column.
model DriverApplication {
  id     String                  @id @default(uuid())
  userId String                  @unique @map("user_id")
  status DriverApplicationStatus @default(NOT_STARTED)

  // Step 1 — personal information
  fullLegalName      String?   @map("full_legal_name")
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  residentialAddress String?   @map("residential_address")

  // Step 2 — driver's license (the image itself is a DRIVERS_LICENSE document)
  licenseNumber     String?   @map("license_number")
  licenseExpiryDate DateTime? @map("license_expiry_date") @db.Date

  // Step 3 — vehicle (photo and registration scan are documents)
  vehicleMake            String?   @map("vehicle_make")
  vehicleModel           String?   @map("vehicle_model")
  vehicleYear            Int?      @map("vehicle_year")
  vehicleColor           String?   @map("vehicle_color")
  // Unique across applications so two applicants can't claim one plate.
  // Postgres allows many NULLs under a unique index, so unsubmitted
  // applications don't collide with each other.
  plateNumber            String?   @unique @map("plate_number")
  registrationExpiryDate DateTime? @map("registration_expiry_date") @db.Date

  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime? @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile?
  documents     DriverDocument[]

  @@index([status])
  @@map("driver_applications")
}

// Exists only for verified drivers — it is created by an approved
// DriverApplication review and never before, so the row's existence IS the
// verification. Vehicle and license details are read through `application`
// rather than duplicated here.
model DriverProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  driverApplicationId String    @unique @map("driver_application_id")
  isOnline            Boolean   @default(false) @map("is_online")
  // Source of truth for reads/writes from the app layer.
  currentLat          Float?    @map("current_lat")
  currentLng          Float?    @map("current_lng")
  locationUpdatedAt   DateTime? @map("location_updated_at")
  // Derived PostGIS geography point, kept in sync with currentLat/currentLng by a
  // DB trigger (see migration `..._add_postgis_geography`). Not writable through
  // Prisma Client directly — query it with $queryRaw (see MatchingService).
  location            Unsupported("geography(Point, 4326)")?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application DriverApplication @relation(fields: [driverApplicationId], references: [id])
  offers      RideOffer[]

  @@index([isOnline])
  @@map("driver_profiles")
}

model DriverDocument {
  id                  String             @id @default(uuid())
  driverApplicationId String             @map("driver_application_id")
  type                DriverDocumentType
  // Opaque key into StorageService — a relative path for local disk storage
  // today, an S3 object key if that ever replaces it. Never a public URL:
  // these are ID documents, served only through an authenticated endpoint.
  storageKey          String             @map("storage_key")
  originalFilename    String             @map("original_filename")
  mimeType            String             @map("mime_type")
  sizeBytes           Int                @map("size_bytes")
  uploadedAt          DateTime           @default(now()) @map("uploaded_at")

  application DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)

  // One current document per type — re-uploading replaces in place.
  @@unique([driverApplicationId, type])
  @@map("driver_documents")
}

model RideRequest {
  id             String                                @id @default(uuid())
  riderId        String                                @map("rider_id")
  pickupLat      Float                                 @map("pickup_lat")
  pickupLng      Float                                 @map("pickup_lng")
  dropoffLat     Float                                 @map("dropoff_lat")
  dropoffLng     Float                                 @map("dropoff_lng")
  // Derived from pickupLat/pickupLng by a DB trigger; see MatchingService for reads.
  pickupLocation Unsupported("geography(Point, 4326)")? @map("pickup_location")
  suggestedFare  Decimal                               @map("suggested_fare")
  status         RideRequestStatus                     @default(PENDING)
  cancelReason   String?                               @map("cancel_reason")
  cancelledAt    DateTime?                             @map("cancelled_at")
  createdAt      DateTime                              @default(now()) @map("created_at")

  rider  User        @relation("RiderRideRequests", fields: [riderId], references: [id])
  offers RideOffer[]
  trip   Trip?

  @@index([status, createdAt])
  @@map("ride_requests")
}

model RideOffer {
  id            String      @id @default(uuid())
  rideRequestId String      @map("ride_request_id")
  driverId      String      @map("driver_id")
  offeredFare   Decimal     @map("offered_fare")
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  expiresAt     DateTime?   @map("expires_at")

  rideRequest RideRequest   @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  driver      DriverProfile @relation(fields: [driverId], references: [id])

  @@unique([rideRequestId, driverId])
  @@index([rideRequestId, status])
  @@map("ride_offers")
}

model Trip {
  id            String     @id @default(uuid())
  rideRequestId String     @unique @map("ride_request_id")
  driverId      String     @map("driver_id")
  riderId       String     @map("rider_id")
  agreedFare    Decimal    @map("agreed_fare")
  status        TripStatus @default(STARTED)
  routePolyline String?    @map("route_polyline")
  startedAt     DateTime?  @map("started_at")
  endedAt       DateTime?  @map("ended_at")
  cancelReason  String?    @map("cancel_reason")
  createdAt     DateTime   @default(now()) @map("created_at")

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])
  driver      User        @relation("DriverTrips", fields: [driverId], references: [id])
  rider       User        @relation("RiderTrips", fields: [riderId], references: [id])
  ratings     Rating[]

  @@index([status])
  @@map("trips")
}

model Rating {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  trip     Trip @relation(fields: [tripId], references: [id])
  fromUser User @relation("RatingsFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsTo", fields: [toUserId], references: [id])

  @@unique([tripId, fromUserId, toUserId])
  @@map("ratings")
}
