# connection_limit: Prisma defaults to a tiny pool (num_cpus-derived, ~9 on
# an 8-core box) when this is unset — verified empirically to hard-fail with
# P2024 "Timed out fetching a new connection" at ~2,000 concurrent DB-bound
# requests. 25 per instance is deliberate, not arbitrary: keep
# (app instances × connection_limit) comfortably under Postgres's
# max_connections (200, set in docker-compose.yml's postgres command) to
# leave headroom for migrations/admin connections. pool_timeout raised from
# the 10s default to 20s so a traffic spike degrades (queues) before it
# hard-fails.
DATABASE_URL="postgresql://reedr:reedr@localhost:5433/reedr?schema=public&connection_limit=25&pool_timeout=20"

JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PASSWORD_RESET_CODE_EXPIRES_IN="15m"

PORT=3300
NODE_ENV=development

REDIS_URL="redis://localhost:6380"

RIDE_MATCH_RADIUS_KM=5
OFFER_EXPIRY_SECONDS=60

# Comma-separated allowed origins for CORS (HTTP + WebSocket). Unset = '*',
# fine for local dev. Set explicitly (e.g. to the mobile app's dev/staging
# URLs) before this is reachable from anywhere but localhost.
# CORS_ORIGIN=http://localhost:19006,https://staging.reedr.app

# Local disk path for driver document uploads. Swap for S3 (see
# src/common/storage) before this ever runs on more than one instance —
# local disk doesn't survive a redeploy or scale past one box.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
