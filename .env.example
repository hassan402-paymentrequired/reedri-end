DATABASE_URL="postgresql://reedr:reedr@localhost:5433/reedr?schema=public"

JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3300
NODE_ENV=development

REDIS_URL="redis://localhost:6380"

RIDE_MATCH_RADIUS_KM=5
OFFER_EXPIRY_SECONDS=60

# Comma-separated allowed origins for CORS (HTTP + WebSocket). Unset = '*',
# fine for local dev. Set explicitly (e.g. to the mobile app's dev/staging
# URLs) before this is reachable from anywhere but localhost.
# CORS_ORIGIN=http://localhost:19006,https://staging.reedr.app
